# 复制为 .env 后按需修改。.env 已被 gitignore，不会进入版本库。

# ---------------------------------------------------------------------------
# 安全相关：本地试跑可以留空，对外提供服务前必须逐项设置
# ---------------------------------------------------------------------------

# 登录令牌的签名密钥。留空时每次启动随机生成一把，重启即掉登录状态，
# 多进程部署还会互相不认。生成一串够长的随机值：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# 模型 API Key 的加密密钥（Fernet）。一旦用它保存过模型配置就必须持续备份，
# 换掉之后已存的 Key 解不开，需要重新填写。生成：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_CONFIG_ENCRYPTION_KEY=

# 首次启动创建的管理员账号。密码留空则随机生成一个并在启动日志里打印一次，
# 登录后请立即修改。
INITIAL_ADMIN_EMPLOYEE_NO=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=系统管理员

# 登录令牌有效期（小时），默认 168（7 天）
ACCESS_TOKEN_TTL_HOURS=168

# ---------------------------------------------------------------------------
# 数据与存储
# ---------------------------------------------------------------------------

# 单人使用用 SQLite 即可；多人共用改成 postgresql://user:pass@host:5432/dbname
# （PostgreSQL 驱动来自 postgres 附加依赖：pip install -e "./apps/api[postgres]"）
DATABASE_URL=sqlite:///./teaching_design.db

UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
# 课次材料（作业、试卷）的落盘目录，留空则用 UPLOAD_DIR 下的子目录
TASK_FILE_DIR=

# ---------------------------------------------------------------------------
# 前端与网络
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:8000
VITE_BASE_PATH=/
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# 仅 docker compose 部署需要
# ---------------------------------------------------------------------------

# compose 没有给密码留默认值：共享的默认密码等于没有密码
POSTGRES_DB=teaching_design
POSTGRES_USER=teaching
POSTGRES_PASSWORD=

# 对外监听。绑域名走 Nginx 反代时改成 WEB_HOST=127.0.0.1，别把端口直接暴露到公网
WEB_HOST=0.0.0.0
WEB_PORT=8081
